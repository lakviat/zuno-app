    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "maplibre-gl": "^6.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:preview": "node scripts/ios-preview.mjs",
    "ios:prepare": "node scripts/ios-distribution.mjs --prepare-only",
    "ios:archive:unsigned": "node scripts/ios-distribution.mjs",
    "ios:archive:signed": "node scripts/ios-distribution.mjs --signed",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "test:e2e:phone": "ZUNO_TEST_PHONE_PREVIEW=1 playwright test",
    "build:native": "expo export --platform ios --platform android",
    "postinstall": "node scripts/prepare-web.mjs",
    "test:backend": "node scripts/test-supabase-local.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
