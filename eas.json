{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "testflight": {
      "distribution": "store",
      "env": { "ZUNO_BUILD_CHANNEL": "testflight" },
      "ios": { "simulator": false, "buildConfiguration": "Release" }
    },
    "production": { "extends": "testflight" }
  }
}
