# Connected TestFlight builds require the two public Supabase values below.
# Unconfigured Development builds are local previews; Release shows a connection setup screen. Never put privileged keys in EXPO_PUBLIC_*.
# Optional after enrollment; use your own ten-character Team ID. Not a password.
ZUNO_APPLE_TEAM_ID=
# Distribution preparation forces testflight. Use development only for native Metro builds.
ZUNO_BUILD_CHANNEL=
# Standalone Android builds only. Restrict this key to your app package/signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
# Online social backend. Both values are required for a connected build.
# Obtain the Project URL and publishable key from Supabase Connect.
# Public client configuration only. Never use a service-role/secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Owner-provided public legal pages, HTTPS only. No fabricated links.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Optional, development web on localhost only. Uses sample data, no hosted Auth.
# PIN/code are disposable UI fixtures; never production authentication.
EXPO_PUBLIC_LOCAL_TEST_LOGIN=
